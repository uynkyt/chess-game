{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "next-dev",
      "type": "shell",
      "command": "source \"$HOME/.nvm/nvm.sh\" && nvm use && npm run dev -- --hostname 127.0.0.1 --port 3000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
